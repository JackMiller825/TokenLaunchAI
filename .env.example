# Copy to .env. Never commit .env.

DATABASE_URL="postgresql://tokenlaunch:tokenlaunch@127.0.0.1:5432/tokenlaunch?schema=public"
REDIS_URL="redis://127.0.0.1:6379"
# inline runs research in the Next.js process. Use bullmq in production with `npm run worker`.
JOB_RUNNER="inline"

# Required in production. Any long random string is fine locally.
SESSION_SECRET="replace-with-a-long-random-string"
# 64 hex characters unlock encrypted storage of a per-organization Telegram bot token.
ENCRYPTION_KEY=""

# dev-auto signs in the seeded owner on this machine. Use credentials in any shared deployment.
AUTH_MODE="dev-auto"
SEED_EMAIL="owner@tokenlaunch.local"
SEED_PASSWORD="launch-desk-dev"
SEED_NAME="Launch Manager"

APP_URL="http://127.0.0.1:43123"

# Optional providers. Empty means the feature stays manual and says so.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
IMAGE_PROVIDER="none"

# none | brave | serper
SEARCH_PROVIDER="none"
SEARCH_API_KEY=""

# Read-only Ethereum JSON-RPC. Example public endpoint: https://ethereum.publicnode.com
ETH_RPC_URL=""
ETHERSCAN_API_KEY=""

TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
# Comma-separated numeric Telegram user ids allowed to use admin bot commands.
TELEGRAM_ADMIN_IDS=""
# Set to 1 to long-poll getUpdates from the worker. Do not enable this and a webhook together.
TELEGRAM_POLL="0"

# Set to 1 only after `npx playwright install chromium`.
PLAYWRIGHT_ENABLED="0"
